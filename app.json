{
  "title": "Open Application",
  "rules": [
    {
      "description": "Hyper+1 to Open finder",
      "manipulators": [
        {
          "from": {
            "key_code": "1",
            "modifiers": {
              "mandatory": [
                "left_command",
                "left_control",
                "left_shift",
                "left_option"
              ]
            }
          },
          "to": [
            {
              "shell_command": "open -a 'finder'"
            }
          ],
          "type": "basic"
        }
      ]
    },
